# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet or Vercel deployment is hosted.
APP_URL="https://your-domain.vercel.app"

# ADMIN_SESSION_SECRET: Secret key used to sign admin session tokens.
# Set a unique 32+ character random string in Vercel Environment Variables.
ADMIN_SESSION_SECRET="cinematography-super-secret-key-salt-981249"

# =========================================================================
# PERSISTENT EXTERNAL DATABASE & CLOUD STORAGE (VERCEL & GITHUB DEPLOYMENT)
# =========================================================================

# Option A: Supabase Integration (Recommended for Vercel)
# Create a free project at https://supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Option B: Vercel KV / Upstash Redis (Near-instant serverless KV storage)
# Automatically provisioned via Vercel Dashboard -> Storage -> KV
KV_REST_API_URL="https://your-kv-instance.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-api-token"
